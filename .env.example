# Copy to .env (never commit .env). Get keys from Razorpay Dashboard → API Keys.
# GO-LIVE: use Live mode keys (rzp_live_…) — see docs/RAZORPAY-GO-LIVE.md
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret

# Local payments API only (production site uses Cloudflare Worker URL by default)
PORT=8787
