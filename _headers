# WoodenMax — Cloudflare Pages custom headers (NOT YAML — Plain Text / Cloudflare _headers syntax)
# https://developers.cloudflare.com/pages/configuration/headers/
# Path rules use leading /. Header lines are indented with two spaces.
# Editor: if you see YAML errors on lines with *, ignore them or use Plain Text mode.

# Pricing API (HTML + JSON responses)
/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  X-Robots-Tag: index, follow

/api/calculate
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  Content-Type: text/html; charset=utf-8

/api/calculate/
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  Content-Type: text/html; charset=utf-8

# Public pricing data (widget + API engine fetch)
/data/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type
  Cache-Control: public, max-age=3600

/data/*.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8

/data/pricing-engine.js
  Access-Control-Allow-Origin: *
  Content-Type: application/javascript; charset=utf-8

# Embeddable calculator widget
/tools/woodenmax-widget.js
  Access-Control-Allow-Origin: *
  Content-Type: application/javascript; charset=utf-8

# Static assets — long cache + WebP
/images/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=604800

# Estimate UX + Razorpay UI — short cache so deploys show up (CDN was serving 7-day-old JS)
/js/calculator-mobile-ux.js
  Cache-Control: public, max-age=300, must-revalidate
/js/razorpay-checkout.js
  Cache-Control: public, max-age=300, must-revalidate
/js/site-footer.js
  Cache-Control: public, max-age=300, must-revalidate
/js/mirror-page-analytics.js
  Cache-Control: public, max-age=300, must-revalidate
/js/analytics-events.js
  Cache-Control: public, max-age=300, must-revalidate
/js/analytics.js
  Cache-Control: public, max-age=300, must-revalidate
/css/calculator-mobile-ux.css
  Cache-Control: public, max-age=300, must-revalidate

/js/*
  Cache-Control: public, max-age=604800

# GSC: noindex utility URLs
/search
  X-Robots-Tag: noindex, nofollow
/search/*
  X-Robots-Tag: noindex, nofollow
/calculator-design-preview.html
  X-Robots-Tag: noindex, nofollow
