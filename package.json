{
  "name": "woodenmax-live",
  "private": true,
  "description": "WoodenMax static site build tools",
  "scripts": {
    "optimize:speed": "node tools/optimize-speed.cjs",
    "optimize:speed:dry": "node tools/optimize-speed.cjs --dry",
    "fix:head": "node tools/fix-head-assets.cjs",
    "fix:seo-urls": "node tools/fix-seo-urls.cjs",
    "payments:dev": "npx wrangler dev",
    "payments:deploy": "npx wrangler deploy",
    "payments:health": "node -e \"fetch('https://jolly-field-be49.finilexnaseem.workers.dev/health').then(r=>r.json()).then(console.log).catch(console.error)\"",
    "payments:setup-live": "powershell -ExecutionPolicy Bypass -File tools/set-razorpay-live-secrets.ps1",
    "db:create": "npx wrangler d1 create woodenmax",
    "db:migrate": "npx wrangler d1 migrations apply woodenmax --remote",
    "db:migrate:local": "npx wrangler d1 migrations apply woodenmax --local",
    "audit:storage": "node tools/audit-quote-storage.cjs",
    "test:quote": "node --test tools/test-quote-isolation.mjs",
    "test:orders": "node --test tools/test-order-pipeline.mjs",
    "test": "node --test tools/test-quote-isolation.mjs tools/test-order-pipeline.mjs",
    "rates:sync": "node tools/sync-package-rates-html.cjs",
    "rates:verify": "node tools/inject-standard-packages-ssr.cjs --verify && node tools/verify-pricing-sync.cjs",
    "pricing:ci": "node tools/test-pricing-models.cjs && node tools/inject-standard-packages-ssr.cjs --verify && node tools/verify-pricing-sync.cjs && node tools/test-rate-sync-idempotence.cjs && node tools/inject-standard-packages-ssr.cjs --verify && node tools/verify-pricing-sync.cjs",
    "merchant:feed": "python tools/generate_merchant_feed.py",
    "merchant:packages": "node tools/generate-package-merchant-feed.cjs",
    "merchant:all": "npm run rates:sync && python tools/generate_merchant_feed.py && node tools/generate-package-merchant-feed.cjs",
    "merchant:verify": "node tools/verify-package-feed-images.cjs"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
