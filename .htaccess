# ============================================
# Apache .htaccess Configuration File
# ============================================

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ============================================
# CRITICAL REDIRECTS (Correct Order)
# ============================================

# 1️⃣ FORCE HTTPS (MUST BE FIRST - prevents redirect chains)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2️⃣ FORCE WWW OR NON-WWW (choose one)
# Remove www (recommended for SEO)
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Or add www (uncomment if you prefer www)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 3️⃣ FOLDER REDIRECT (remove project folder name from URLs)
# Redirect folder name (woodenmaxwebsite-main) from URLs
RewriteCond %{REQUEST_URI} ^/woodenmaxwebsite-main/(.*)$ [NC]
RewriteRule ^woodenmaxwebsite-main/(.*)$ /$1 [R=301,L]

RewriteCond %{REQUEST_URI} ^/woodenmaxwebsite-main/?$ [NC]
RewriteRule ^woodenmaxwebsite-main/?$ / [R=301,L]

# ============================================
# URL CLEANUP RULES
# ============================================

# Remove trailing slash (except root)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/$ /$1 [R=301,L]

# Redirect index.html → /
RewriteCond %{THE_REQUEST} \s/index\.html(\s|\?) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Remove .html extension from URLs (EXTERNAL REDIRECT)
# External redirect from .html to non-.html
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html(\s|\?) [NC]
RewriteRule ^ %1 [R=301,L]

# Redirect uppercase .HTML/.HTM → lowercase version
RewriteCond %{REQUEST_URI} \.(HTML|HTM)$ [NC]
RewriteRule ^(.*)\.(HTML|HTM)$ /$1 [R=301,L]

# Internally load .html when user opens clean URL (INTERNAL REWRITE)
# Example: /products/window  ->  /products/window.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

</IfModule>

# =========================
# Compression
# =========================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>

# =========================
# Browser Caching
# =========================
<IfModule mod_expires.c>
  ExpiresActive On
  
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"

  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  ExpiresByType text/html "access plus 1 hour"

  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

# =========================
# Cache-Control Headers
# =========================
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|avif)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# =========================
# Security Headers
# =========================
<IfModule mod_headers.c>

  Header set X-XSS-Protection "1; mode=block"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # SAFE CSP for production
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googleapis.com https://*.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline' https://*.googleapis.com; font-src 'self' https://*.googleapis.com https://*.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.google-analytics.com https://*.googletagmanager.com https://jolly-field-be49.finilexnaseem.workers.dev; frame-ancestors 'self';"

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  Header set Cross-Origin-Opener-Policy "same-origin"

</IfModule>

# =========================
# Error Pages
# =========================
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# =========================
# Defaults
# =========================
AddDefaultCharset UTF-8
Options -Indexes
